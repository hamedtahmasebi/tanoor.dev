{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main-window permissions for the Tanoor desktop application",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "window-state:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "codex",
          "cmd": "codex",
          "args": true,
          "sidecar": false
        },
        {
          "name": "git",
          "cmd": "git",
          "args": true,
          "sidecar": false
        }
      ]
    }
  ]
}
