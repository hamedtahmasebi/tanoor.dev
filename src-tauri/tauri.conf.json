{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tanoor",
  "version": "0.1.0",
  "identifier": "com.aiworkflowautomation.forge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tanoor — AI workflow automation",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "AI Workflow Automation",
    "category": "DeveloperTool",
    "shortDescription": "Run and review Codex tasks in isolated Git worktrees.",
    "longDescription": "Tanoor is a desktop workspace for running Codex tasks in isolated Git worktrees, reviewing cumulative diffs, and requesting follow-up changes before approval.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
